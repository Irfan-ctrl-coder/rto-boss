# Production
NODE_ENV=production
PORT=3000

# REQUIRED: use a long random value
ADMIN_MASTER_SECRET=replace_with_a_long_random_admin_secret
ADMIN_SESSION_TOKEN=replace_with_a_long_random_session_token

# Optional if frontend is hosted separately
# FRONTEND_URL=https://your-frontend.example

# Payment configuration
# NONE until a real gateway is integrated.
# Supported target values: RAZORPAY or PAYTM
PAYMENT_PROVIDER=NONE

# Keep DISABLED in production until the real gateway + webhook is implemented.
PAYMENT_MODE=DISABLED

# Local-only test mode:
# NODE_ENV=development
# PAYMENT_MODE=TEST
# The backend only permits TEST payment requests from localhost.
